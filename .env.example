# =====================================================================
#  little-buddy configuration
#  Copy this file to `.env` and fill in the REQUIRED values.
#  `.env` is git-ignored. Never commit it; it contains your bot token.
# =====================================================================

# ---------- Discord (REQUIRED) ----------
# Bot token: Developer Portal > your app > Bot > Reset Token.  See docs/discord-setup.md
DISCORD_TOKEN=
# YOUR Discord user ID (not the bot's): Settings > Advanced > Developer Mode,
# then right-click your name > Copy User ID. The bot only responds to this user.
OWNER_ID=
# Optional: a server channel ID to chat and receive reminders in. Empty = use DMs.
CHANNEL_ID=

# ---------- Personal ----------
# What the assistant calls itself.
BOT_NAME=Buddy
# Your time zone, as an IANA name. Examples: America/New_York, America/Chicago,
# America/Los_Angeles, Europe/London, Europe/Berlin, Asia/Tokyo, Australia/Sydney
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York
# Morning digest time (24h, local).
DIGEST_TIME=08:00
# Default reminder lead time before events/deadlines, in minutes.
REMIND_LEAD_MINUTES=30

# ---------- AI model ----------
# Hardware profiles (see "Hardware profiles" in README.md):
#   8 GB GPU (RTX 2070 Super / 3070 / 4060): OLLAMA_MODEL=qwen3:8b, OLLAMA_NUM_CTX=6144,
#       SKILLS_DISABLED=web unless you use it. With Ollama's flash attention + q8_0 KV cache
#       turned on (Ollama server settings, not this file), try OLLAMA_NUM_CTX=10240.
#   12 GB GPU (RTX 4070 / 3060 12 GB):       OLLAMA_MODEL=qwen3:14b, OLLAMA_NUM_CTX=8192
#   Measure on your machine with: .venv\Scripts\python tools\bench.py
# Which backend: "ollama" (default), or "openai" for ANY OpenAI-compatible server
# (llama.cpp server, LM Studio, vLLM, text-generation-webui, or a cloud API).
LLM_PROVIDER=ollama
# Ollama's address (used when LLM_PROVIDER=ollama). Change if it runs on another machine.
OLLAMA_HOST=http://localhost:11434
# For LLM_PROVIDER=openai: the server's base URL (ending in /v1) and API key if it needs one.
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=
# Model name. Must support tool calling. See "Choosing a model" in README.md.
OLLAMA_MODEL=qwen3:8b
# Optional smaller model for side jobs (summaries, rewrites). Empty = same as the main model.
LLM_FAST_MODEL=
# Context window in tokens. Lower = less VRAM. 6144 fits qwen3:8b in 8 GB.
# Tools, memories and chat history are budgeted to fit, so raising this on bigger hardware
# directly gives the assistant more memory and longer conversations.
OLLAMA_NUM_CTX=6144
# How many model requests may run at once (raise if your server handles parallel requests).
LLM_CONCURRENCY=1
# Max tool-use steps per message (multi-step tasks need several).
LLM_MAX_STEPS=8
# How long the model stays loaded after a message ("-1" = forever, "0" = unload immediately).
OLLAMA_KEEP_ALIVE=30m
# qwen3 "thinking" mode: slower, rarely needed here. Leave EMPTY for models without it.
OLLAMA_THINK=false
# Optional embedding model for meaning-based memory search, e.g. nomic-embed-text
# (`ollama pull nomic-embed-text`, ~300 MB). Empty = keyword search only.
EMBED_MODEL=

# ---------- Assistant ----------
# How the assistant refers to you in its instructions (e.g. your first name). Empty = "the user".
OWNER_NAME=
# Personality and standing instructions, in plain text. Copy docs/persona.example.md there and edit.
# PERSONA_FILE=data/persona.md
# Skills to turn off, comma-separated (folder/file names in skills/), e.g. checkins,web
SKILLS_DISABLED=
# Extra folders with your own skills (";" between folders on Windows, ":" on Linux/macOS).
SKILL_PATHS=

# ---------- Web access (optional) ----------
# Lets the assistant search the web and read pages. Off by default: when on, search queries
# and page requests leave your machine (to DuckDuckGo and the sites it visits).
WEB_ENABLED=false
# How much text of a page the model gets (characters).
WEB_MAX_CHARS=4000

# ---------- Google Calendar (optional) ----------
# See docs/google-calendar-setup.md. Needs data/credentials.json and a one-time `python -m skills.planner.gcal` run.
GCAL_ENABLED=false
# "primary" = your main calendar. Other calendars: Google Calendar > Settings > (calendar) > Calendar ID.
GCAL_CALENDAR_ID=primary
# How many days ahead to sync, and how often (minutes).
GCAL_SYNC_DAYS=30
GCAL_SYNC_MINUTES=5
# Length of new events the bot creates, in minutes.
GCAL_EVENT_MINUTES=60
# Google events whose title contains any of these words are tagged as work (comma-separated).
# Example: standup,sprint,1:1
GCAL_WORK_KEYWORDS=

# ---------- Work / life separation ----------
# Days you work. On other days, work items are hidden from the digest and agenda,
# and work reminders are postponed to the next work morning.
WORK_DAYS=mon,tue,wed,thu,fri

# ---------- Daily work check-in ----------
# The bot asks "what did you get done today?" and re-asks until you answer (or `!skip`).
WORK_CHECKIN_TIME=14:30
WORK_CHECKIN_UNTIL=18:00
WORK_CHECKIN_NAG_MINUTES=30
WORK_CHECKIN_DAYS=mon,tue,wed,thu,fri

# ---------- Advanced ----------
# Upper limit on recent chat messages the model sees (the context budget usually trims sooner).
HISTORY_MESSAGES=40
# Database location. Default: data/jarofass.db. Move it out of cloud-synced folders
# (OneDrive/Dropbox) if you see "database is locked" errors.
# DB_PATH=

# ---------- Delegating coding work to Claude Code (optional) ----------
# See docs/delegation.md. Repositories the agent may work in, as name=path pairs. Empty = off.
# AGENT_REPOS=minecraft-ai=~/minecraft-ai,little-buddy=~/little-buddy
# Path to the Claude Code CLI. Default: ~/.local/bin/claude if it exists, else "claude".
# CLAUDE_PATH=
# "sonnet" or "opus". Opus is only used when you ask for it by name.
AGENT_DEFAULT_MODEL=sonnet
# Spend limits: per run (enforced by Claude Code) and per calendar month (checked before each run).
AGENT_MAX_BUDGET_USD=5
AGENT_MONTHLY_BUDGET_USD=50
# How many agents may work at once, and how long one run may take.
AGENT_MAX_CONCURRENT=1
AGENT_TIMEOUT_MINUTES=45
# Claude Code permission mode for unattended runs: auto | acceptEdits | bypassPermissions | dontAsk
AGENT_PERMISSION_MODE=auto
# Where per-task git worktrees live.
# AGENT_WORKTREES=~/.cache/little-buddy/worktrees

# ---------- HTTP API for buddyctl.py on another machine (optional) ----------
# Off unless API_TOKEN is set. Generate a token: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# API_TOKEN=
# 127.0.0.1 = this machine only. Your LAN IP or 0.0.0.0 = reachable from the network (keep the token secret).
API_HOST=127.0.0.1
API_PORT=8765
